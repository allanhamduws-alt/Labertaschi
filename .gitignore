# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/electron-menubar/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/electron-menubar/dist
/electron-menubar/renderer

# compiled native binaries (built from source)
/electron-menubar/resources/bin/macos-globe-listener
!/electron-menubar/resources/bin/macos-globe-listener.swift
/electron-menubar/resources/bin/macos-call-detector
!/electron-menubar/resources/bin/macos-call-detector.swift

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
